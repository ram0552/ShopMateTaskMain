# ──────────────────────────────────────────────────────────────
# ShopMate Server — Environment Variables Example
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Server
PORT=3001
SERVER_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173

# AI / Embeddings
GEMINI_API_KEY=<your-google-gemini-api-key>

# Pinecone Vector DB
PINECONE_API_KEY=<your-pinecone-api-key>
PINECONE_INDEX=shopmate

# Auth (JWT)
JWT_SECRET=<a-long-random-access-token-secret>
JWT_REFRESH_SECRET=<a-long-random-refresh-token-secret>

# Email (Nodemailer / SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=<your-email@example.com>
MAIL_PASSWORD=<your-app-password>

# LangSmith (optional — for LangGraph tracing)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=<your-langsmith-api-key>
LANGSMITH_PROJECT=Shopmate

# Google OAuth
VITE_GOOGLE_CLIENT_ID=<your-google-oauth-client-id>

# ──────────────────────────────────────────────────────────────
# Razorpay Payment Gateway
# Get test keys from: https://dashboard.razorpay.com → Test Mode → API Keys
# NEVER expose RAZORPAY_KEY_SECRET in the frontend or API responses.
# ──────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_<your-key-id>
RAZORPAY_KEY_SECRET=<your-key-secret>

# Webhook secret — set this AFTER creating the webhook in the Razorpay Dashboard.
# Dashboard → Webhooks → Create Webhook → copy the "Secret" field here.
# Events to subscribe: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=<your-webhook-secret>
