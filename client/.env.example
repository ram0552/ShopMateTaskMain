# ShopMate Client — Environment Variables Example
# Copy this file to client/.env and fill in the real values.
# NEVER commit .env to version control.

# Backend API base URL
VITE_API_URL=http://localhost:3001

# Google OAuth Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=<your-google-oauth-client-id>

# Razorpay Key ID (PUBLIC KEY ONLY — never put the secret here)
# Get test keys from: https://dashboard.razorpay.com -> Test Mode -> API Keys
VITE_RAZORPAY_KEY_ID=rzp_test_<your-key-id>

