# ShopMate Client - Environment Variables Example
# Copy this file to client/.env (or configure in Render dashboard for production)
# NEVER commit sensitive production secrets to version control.

# Backend API base URL:
# For local development: http://localhost:3001
# For Render deployment: https://<your-render-backend-name>.onrender.com
VITE_API_URL=http://localhost:3001

# Google OAuth Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=<your-google-oauth-client-id>

# Razorpay Key ID (PUBLIC KEY ONLY - never put the secret here)
VITE_RAZORPAY_KEY_ID=rzp_test_<your-key-id>
